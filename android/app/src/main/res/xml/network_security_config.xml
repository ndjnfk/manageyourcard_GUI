<?xml version="1.0" encoding="utf-8"?>
<!--
  Lets the app talk to a development API over plain http.

  Android 9 (API 28) and above refuse cleartext traffic by default, so a debug
  build pointed at http://10.0.2.2:3333 fails with a bare "cleartext not
  permitted" — which surfaces in the app as a connection error and looks exactly
  like the API being down.

  Only the two local addresses are listed. Everything else, production included,
  still requires https: `cleartextTrafficPermitted` is false by default outside
  these entries, so this cannot quietly downgrade a real deployment.

  Testing on a PHYSICAL device rather than the emulator? Add this machine's LAN
  address as another <domain> below — entries must be hostnames or IPs, CIDR
  ranges are not accepted — and point NATIVE_API_URL in src/app/shared/api.ts at
  the same address:

      <domain includeSubdomains="false">192.168.1.5</domain>
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- This development machine on the local network — what a physical
             handset connects to. Both it and the phone must be on the same
             Wi-Fi, and this has to be updated if the router hands the PC a
             different address. Keep it in step with NATIVE_API_URL in
             src/app/shared/api.ts. -->
        <domain includeSubdomains="false">192.168.29.179</domain>
        <!-- The Android emulator's alias for the host machine's localhost. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- The device itself. Used by Capacitor's own live-reload server. -->
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
